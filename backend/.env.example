# Copy to .env for local use. On Render, set these in the dashboard instead.
NODE_ENV=development
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
# Your deployed frontend URL(s), comma separated. Leave empty locally.
FRONTEND_URL=
# MySQL connection string. Leave empty locally (a users.json file is used instead).
# e.g. mysql://user:password@host:3306/dbname
MYSQL_URL=
MYSQL_SSL=false
# Optional: enables Google sign-in (same client ID as in Frontend/login.html)
GOOGLE_CLIENT_ID=
